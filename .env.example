# Copy this file to .env for Docker Compose. Never put real secrets in this example.
# Required: use a long, URL-safe random value because it is embedded in a database URL.
CDK_POSTGRES_PASSWORD=

# Required on the first start. The bootstrap service only runs when the admins table is empty.
CDK_ADMIN_USERNAME=admin
CDK_ADMIN_PASSWORD=

# Public Caddy address. Use localhost for local Compose and a DNS name in production.
CDK_SITE_ADDRESS=localhost

# Runtime options forwarded by Docker Compose.
CDK_LOG_LEVEL=info
CDK_SESSION_COOKIE_SECURE=true
CDK_SESSION_COOKIE_SAMESITE=strict
CDK_RATE_LIMIT_REQUESTS=10
CDK_RATE_LIMIT_WINDOW=1m

# Native development does not automatically read this file. Export these variables in the
# shell that runs Go, using the same password selected above:
# CDK_DATABASE_URL=postgres://cdk:<password>@127.0.0.1:5432/cdk?sslmode=disable
# CDK_REDIS_URL=redis://127.0.0.1:6379
# CDK_HOST=127.0.0.1
# CDK_PORT=8080
# ADMIN_PASSWORD=<admin-password>

# Put this frontend-only setting in web/.env.local instead of the root .env:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
